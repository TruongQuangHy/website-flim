{
  "expo": {
    "name": "HyFlim",
    "slug": "hyflim",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0c0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyflim.app"
    },
    "android": {
      "package": "com.hyflim.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0b0c0f"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
